# Copy to .env and fill in. Never commit .env.
PORT=404750
CORS_ORIGIN=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string

# Database: sqlite (default, nothing to install — file in server/data/) or mysql (production)
DB_CLIENT=sqlite
SQLITE_FILE=
# Only for DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=impress_design

# First admin account (created automatically on first start)
ADMIN_EMAIL=admin@impress-design.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# TopTex API — leave blank to run in dry-run mode (supplier orders recorded locally only)
TOPTEX_URL=https://api.toptex.io
TOPTEX_API_KEY=
TOPTEX_USERNAME=
TOPTEX_PASSWORD=
TOPTEX_TEST_MODE=true
TOPTEX_USAGE_RIGHT=b2b_b2c
TOPTEX_LANG=en
TOPTEX_PAGE_SIZE=10
# Re-download the full catalog every N hours (0 = only at start-up / Admin -> Catalog -> Sync)
CATALOG_REFRESH_HOURS=24

# immediate = one TopTex order per customer order; grouped = admin groups items into one order
VENDOR_ORDER_MODE=grouped

# Workshop (TopTex delivery address for customised orders, and shipping origin)
WORKSHOP_TITLE=Impress Design workshop
WORKSHOP_STREET1=
WORKSHOP_POSTCODE=75001
WORKSHOP_CITY=Paris
WORKSHOP_COUNTRY=fr
WORKSHOP_CONTACT=Impress Design
WORKSHOP_PHONE=
WORKSHOP_EMAIL=

# Invoice header
COMPANY_NAME=Impress Design
COMPANY_ADDRESS=Île-de-France, France
COMPANY_VAT=
COMPANY_EMAIL=
TAX_RATE=0.20

# Marking prices (placeholders — use the workshop price list)
PRINT_SETUP=25
PRINT_PER_UNIT=3.5
EMBROIDERY_SETUP=35
EMBROIDERY_PER_UNIT=5

# Delivery partner: flatrate (offline table in src/config.js) or http (partner API)
SHIPPING_PROVIDER=flatrate
SHIPPING_PARTNER_NAME=Delivery partner
SHIPPING_API_URL=
SHIPPING_API_KEY=
SHIPPING_TRACKING_URL=
FREE_SHIPPING_OVER=0
